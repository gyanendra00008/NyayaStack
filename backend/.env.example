# Application Server
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Primary Authentication Database (MongoDB)
MONGO_URI=mongodb://localhost:27017/nyayastack

# Separated Storage Database (MongoDB for Complaints / Petitions)
STORAGE_MONGO_URI=mongodb://localhost:27017/nyayastack_storage

# JSON Web Token Secret (Required >= 32 characters)
JWT_SECRET=your_super_secret_jwt_key_with_at_least_32_characters_here
JWT_EXPIRES_IN=24h

# Brevo Email Configuration (For OTP Verification & Password Resets)
BREVO_API_KEY=your_brevo_api_key_here
BREVO_SMTP_KEY=your_brevo_smtp_key_here
MAIL_FROM=noreply@nyayastack.com
MAIL_FROM_NAME=NyayaStack

# Cloudinary Storage Configuration (For Complaint File Attachments)
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_DELIVERY_TYPE=upload
CLOUDINARY_FOLDER=nyayastack/complaints

# Google Gemini AI Classification Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_PRIMARY_MODEL=gemini-3.6-flash
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
GEMINI_MODEL=gemini-3.6-flash

# Automatic Time-Based Hierarchical Escalation System
ESCALATION_WINDOW_HOURS=48
ESCALATION_CHECK_INTERVAL_MS=300000
ENABLE_IN_PROCESS_SCHEDULER=true
CRON_SECRET=your_super_secret_cron_webhook_key_here

